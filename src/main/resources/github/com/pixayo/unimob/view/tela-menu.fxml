<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<StackPane prefHeight="640.0" prefWidth="360.0"
           xmlns="http://javafx.com/javafx/17.0.12"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="github.com.pixayo.unimob.controller.TelaMenuController">

    <VBox>
        <HBox fx:id="header"
              minHeight="26.0"
              alignment="BOTTOM_CENTER">
        </HBox>

        <VBox fx:id="main"
              alignment="TOP_CENTER"
              VBox.vgrow="ALWAYS">









        </VBox>

        <HBox fx:id="footer" prefHeight="60.0">
            <Button contentDisplay="TOP" maxHeight="999.0" maxWidth="999.0" onAction="#abrirTelaMapa" prefWidth="0" HBox.hgrow="ALWAYS">
                <graphic>
                    <SVGPath content="m15-3-6-2.1-4.65 1.8q-0.5 0.2-0.925-0.113T3-4.25v-14q0-0.325 0.188-0.575t0.513-0.375l5.3-1.8 6 2.1 4.65-1.8q0.5-0.2 0.925 0.113t0.425 0.838v14q0 0.325-0.188 0.575T20.3-4.8l-5.3 1.8Zm-1-2.45v-11.7l-4-1.4v11.7l4 1.4Zm2 0 3-1v-11.85l-3 1.15v11.7Zm-11-0.25 3-1.15v-11.7l-3 1v11.85Zm11-11.45v11.7-11.7Zm-8-1.4v11.7-11.7Z" styleClass="icon-svg" />
                </graphic>
                Mapa
            </Button>

            <Button contentDisplay="TOP" maxHeight="999.0" maxWidth="999.0" onAction="#abrirTelaHorarios" prefWidth="0" HBox.hgrow="ALWAYS">
                <graphic>
                    <SVGPath content="M3 10a7 7 0 1114 0 7 7 0 01-14 0zm7-9a9 9 0 100 18 9 9 0 000-18zm1 5a1 1 0 10-2 0v4.032l-2.64 2.2a1 1 0 101.28 1.536l3-2.5A1 1 0 0011 10.5V6z" styleClass="icon-svg" />
                </graphic>
                Horários
            </Button>

            <Button contentDisplay="TOP" maxHeight="999.0" maxWidth="999.0" onAction="#abrirTelaFavoritos" prefWidth="0" text="Favoritos" HBox.hgrow="ALWAYS">
                <graphic>
                    <SVGPath content="M5-3v-16q0-0.825 0.588-1.413T7-21h10q0.825 0 1.413 0.588T19-19v16L12-6 5-3Zm2-3.05 5-2.15 5 2.15v-12.95H7v12.95Zm0-12.95h10-10Z" styleClass="icon-svg" />
                </graphic>
                Favoritos
            </Button>

            <Button contentDisplay="TOP" maxHeight="999.0" maxWidth="999.0" onAction="#abrirTelaMenu" prefWidth="0" styleClass="selected" HBox.hgrow="ALWAYS">
                <graphic>
                    <SVGPath content="M3-6v-2h18v2H3Zm0-5v-2h18v2H3Zm0-5v-2h18v2H3Z" styleClass="icon-svg" />
                </graphic>
                Menu
            </Button>
